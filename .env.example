# Address that other machines type into their browser. Do not include http://
# or :3000. This is distinct from the 0.0.0.0 listening address.
MD_EDIT_PUBLIC_HOST=192.168.1.50

# Generated by configure.sh. Hex values avoid URL-escaping problems.
MD_EDIT_DB_PASSWORD=replace-me
MD_EDIT_SESSION_SECRET=replace-me

# Listen on every host interface. Set this to 127.0.0.1 when adding a local
# reverse proxy.
MD_EDIT_BIND_IP=0.0.0.0

# Trusted-LAN defaults: anyone with a note link can collaborate.
MD_EDIT_ALLOW_ANONYMOUS=true
MD_EDIT_ALLOW_ANONYMOUS_EDITS=false
MD_EDIT_ALLOW_EMAIL_REGISTER=true
MD_EDIT_DEFAULT_PERMISSION=freely
